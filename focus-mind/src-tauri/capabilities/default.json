{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "quick-tasks"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPCONFIG/focus-mind.db" },
        { "path": "$APPCONFIG/focus-mind.db.*" },
        { "path": "$APPCONFIG/backups" },
        { "path": "$APPCONFIG/backups/**" }
      ]
    },
    "window-state:default"
  ]
}
